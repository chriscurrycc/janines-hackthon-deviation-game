# Anthropic — the AI opponent uses a Claude vision model to guess the drawing.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Vision model. Haiku 4.5 is the cheapest ($1/$5 per 1M) and supports vision —
# good for local testing. Use claude-sonnet-4-6 ($3/$15) for the stronger tier.
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: override the API base URL (e.g. a proxy/gateway).
# ANTHROPIC_BASE_URL=
